// EAB06 midterm course - the whole course in one scene (sim/world.py loads this).
// JSON with // comments (stripped by the loader). All dimensions are ESTIMATES from the course
// slide + old sim scenes; edit by hand. Flight parameters (config/params.json / midterm.py) are
// ground truth: when they disagree with this file, change this file.
//
// Coordinates (cm): X = east (right on the slide), Y = north (toward the wall), Z = up, floor Z = 0.
// Headings / "facing_deg" (deg): seen from above, 0 = east (+X), CLOCKWISE positive
//   (same sense as Tello yaw): 90 = south (-Y), 180 = west (-X), 270 (or -90) = north (+Y).
//   A marker's facing_deg is the direction its printed side looks at.
// Colors are [R, G, B] 0..255.
// Boxes are axis aligned: "min" / "max" corners. "solid": false = drawn but no collision.
// Tables expand to a top slab (top_z - thickness .. top_z) + 4 square legs.
{
  "name": "EAB06 midterm course",
  "start": {"pos": [0, 0, 0], "heading_deg": 0},          // take-off on the dashed start line, facing east
  "floor": {"min": [-300, -300], "max": [1000, 650], "color": [150, 150, 145]},
  "sky_color": [205, 210, 215],

  "boxes": [
    // north wall, markers 4 / 5 hang on its south face (Y = 500)
    {"name": "wall",        "min": [-100, 500, 0],   "max": [800, 512, 300],  "color": [225, 222, 210]},

    // ---- segment 1 ----
    // board 1 carries marker 1 on its west face (X = 200); 60 deep. Slide: ~100 wide, but S1_RIGHT only
    // moves ~45-50 cm right (SIDE_MAX_TIME 1.5 s at rc 30 x 1.3), so with 100 cm the real flights would hit
    // it in S1_FORWARD -> 60 wide here (parameters win over the slide estimate).
    {"name": "board1",      "min": [200, -30, 0],    "max": [260, 30, 110],   "color": [235, 235, 235]},
    {"name": "low_box",     "min": [260, -30, 0],    "max": [310, 30, 40],    "color": [170, 130, 90]},   // length unknown (slide)
    //   50 cm gap X 310..360
    {"name": "box_100",     "min": [360, -10, 0],    "max": [460, 40, 50],    "color": [170, 130, 90]},
    // board 2 carries marker 2 on its west face (X = 460), offset to the south (drone's right).
    // NOTE: the old run_seg12.py put marker 2 90 cm right and only 170 cm past marker 1. With M2_STOP_DIST
    // = 150 the drone would then stop beside board 1 and hit it in S1_LEFT, so marker 2 moved to X = 460
    // (board1 60 + low box 50 + gap 50 + box 100 as on the slide); and 60 cm right (not 90), the most
    // S1_RIGHT reaches within SIDE_MAX_TIME.
    {"name": "board2",      "min": [460, -110, 0],   "max": [480, -10, 120],  "color": [235, 235, 235]},

    // ---- segment 2 ----
    {"name": "chair_seat",  "min": [677, 307, 0],    "max": [723, 353, 45],   "color": [60, 70, 110]},
    {"name": "chair_back",  "min": [677, 347, 45],   "max": [723, 353, 90],   "color": [60, 70, 110]},

    // ---- segment 4 ----
    // board 3 between markers 4 and 5 (see the marker 5 note below), top lower than the markers; 45 wide so it
    // fits between the landing table (x 145..195) and the drone's path down from marker 4
    {"name": "board3",      "min": [200, 330, 0],    "max": [245, 480, 150],  "color": [235, 235, 235]}
  ],

  "tables": [
    // table 1: tunnel; marker 3 hangs on its east edge. Underside ~67 (old run_seg345.py)
    {"name": "table1", "x": [425, 500], "y": [250, 500], "top_z": 72, "thickness": 5, "leg": 5,
     "color": [190, 160, 120]},
    // landing table: 50 wide, centre 165 cm from the wall (= M5_DIST) straight below marker 5 (x = 170)
    {"name": "land_table", "x": [145, 195], "y": [310, 360], "top_z": 75, "thickness": 4, "leg": 4,
     "color": [190, 160, 120]}
  ],

  // markers: centre position (cm), facing_deg (see top), side length (cm, black part).
  // A marker whose centre lies on a box face is drawn on that box; otherwise ("mount": "sign")
  // a thin white sign plate is created behind it (solid, so it can be hit).
  "markers": [
    {"id": 1, "pos": [200, 0, 80],     "facing_deg": 180, "size": 15},   // old sim: height 80
    {"id": 2, "pos": [460, -60, 80],   "facing_deg": 180, "size": 15},   // 60 cm right of marker 1 (see board2)
    {"id": 3, "pos": [501, 350, 60],   "facing_deg": 0,   "size": 15, "mount": "sign"},  // hangs on table 1 edge
    {"id": 4, "pos": [275, 500, 215],  "facing_deg": 90,  "size": 15},   // real log: tof 222..231 aligned
    // marker 5: 105 cm west of marker 4 (slide: ~250). The parameters win: S4_LEFT slides at
    //   S4_LEFT_SPEED 30 x SPEED_SCALE_MOVE 1.3 = rc 39 -> ~33 cm/s (0.85 cm/s per rc, S3_UNDER_CM_PER_RC) for at most
    //   S4_MAX_TIME 3 s / 1.3 (SCALE_TIMES) = 2.3 s = ~76 cm (kinematic); with inertia ~62 cm is covered inside the
    //   state, and the last ~0.25 s do not count (video latency 0.15 s + ARRIVE_FRAMES 3). From M4_DIST 150 cm a
    //   15 cm marker is detected up to ~72 cm off the image centre (left half-FOV 28 deg, measured in the sim).
    //   So marker 5 must be at most ~72 + 50 = ~120 cm from where S4 starts (in front of marker 4).
    //   105 cm -> needs ~33 cm of sliding: seen ~1.5 s into the 2.3 s budget (margin ~0.8 s / ~25 cm).
    //   With 150 cm (lead's first guess) it needs ~78 cm: not reachable without S4_WAIT5 + a manual l.
    //   If a real flight shows the Tello slides faster than 0.85 cm/s per rc, this distance can grow.
    {"id": 5, "pos": [170, 500, 215],  "facing_deg": 90,  "size": 15}
  ],
  "marker_margin": 2.5,       // white border printed around each marker (cm)

  // floor tape (drawn only)
  "lines": [
    {"name": "start",  "from": [0, -100],  "to": [0, 100],   "width": 4, "color": [30, 30, 30], "dashed": true},
    {"name": "solid",  "from": [50, -100], "to": [50, 100],  "width": 4, "color": [30, 30, 30]},
    {"name": "blue",   "from": [650, 250], "to": [650, 450], "width": 5, "color": [30, 80, 220]}
  ],

  // dummy human carrying marker 0 (sim/human.py): a cooperative person who keeps the drone with him
  "human": {
    "marker_id": 0,
    "start": [500, 60],               // waits north-east of the drone's stop in front of marker 2 (~1.7 m ahead-left)
    "speed": 20.0,                    // walking speed (cm/s). The drone follows at ~33 cm/s at most when the marker
                                      //   is straight ahead (FOLLOW_FB_MAX 45 x 1.3 x 0.85) and much slower while it
                                      //   turns (FOLLOW_TURN_FIRST_DEG), so a slow walk keeps the marker in view
    "trigger_dist": 130.0,            // starts walking when the drone is this close AND sees marker 0
    "slow_dist": 75.0,                // drone farther than this (marker-to-camera) -> walk at half speed
    "lag_dist": 100.0,                // drone farther than this -> stop and wait ...
    "resume_dist": 80.0,              // ... until it is closer than this again with the marker in view
    "view_half_deg": 20.0,            // marker counts as "in the drone's view" within this angle of the camera axis
                                      //   (camera half-FOV is ~28 deg horizontally)
    "lost_grace": 0.3,                // marker out of view longer than this (s) -> stop and wait
    "resume_hold": 0.5,               // marker back in view this long (s) before walking on
    "hold_dist": 30.0,                // marker held this far in front of the body
    "hold_height": 112.0,             // marker 0 centre height = about the drone's camera height in segment 2: the drone
                                      //   leaves segment 1 at ~120 (bottom; set by the marker 1 / 2 alignment) and S2 only
                                      //   corrects height beyond UD_DEAD 15 cm. With 100 the marker dropped out of the
                                      //   bottom of the frame at FOLLOW_DIST (45 cm) and the drone gave up following.
    "follow_drone_height": false,     // true = marker follows the drone camera height (50..200). Careful: with the
                                      //   camera pitched down the drone climbs to centre the marker -> both climb
    // path: to the south side of the chair, one full counter-clockwise circle (radius 150 round (700, 320), just
    // south of the chair centre so the north side stays 30 cm off the wall). The drone follows 45-80 cm behind and
    // cuts inside the circle (radius ~100 with 150; with 120 it passed ~15 cm from the chair, over its back), on round
    // to the north side, then south-west so the drone ends just east of the blue line facing west-south-west with
    // marker 3 (500, 350) ~15 deg left of its heading. Note: a circle round the chair must cross the blue line
    // (x = 650, only 27 cm west of the chair) unless it goes round the line's ends.
    "path": [[600, 140], [700, 170], [775, 190], [830, 245], [850, 320], [830, 395], [775, 450], [700, 470], [625, 450], [570, 395], [550, 320], [570, 245], [625, 190], [700, 170], [775, 190], [830, 245], [850, 320], [830, 395], [775, 450], [700, 470], [640, 440], [605, 385]],
    "end_wait": 1.5,                  // at the end: once the drone has caught up, stand this long, then hide the marker
    "leave_path": [[605, 470], [800, 470]],   // after hiding: walk out of the way (north, then east)
    "body_color": [60, 110, 170],
    "skin_color": [225, 190, 160]
  }
}
