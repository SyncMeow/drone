#!/bin/sh

CURPATH="$(cd "$(dirname "$0")" && pwd)"
TARGET="lab$1.py"
: "${TARGET:?Target must be specified.}"

__conda_setup="$('/Users/shinmeow/miniconda3/bin/conda' 'shell.zsh' 'hook' 2> /dev/null)"
if [ $? -eq 0 ]; then
    eval "$__conda_setup"
else
    if [ -f "/Users/shinmeow/miniconda3/etc/profile.d/conda.sh" ]; then
        . "/Users/shinmeow/miniconda3/etc/profile.d/conda.sh"
    else
        export PATH="/Users/shinmeow/miniconda3/bin:$PATH"
    fi
fi
unset __conda_setup

conda activate uav
python3 "$CURPATH/$TARGET" > "$CURPATH/log/out.log" 2> "$CURPATH/log/err.log"

cat "$CURPATH/log/out.log"
cat "$CURPATH/log/err.log"
